# Copy to /opt/hermes-hub/env (chmod 600). Loaded by the systemd unit.
# Path to Hermes's own .env holding API_SERVER_KEY (the key the app uses)
HERMES_ENV=/home/<user>/.hermes/.env
HERMES_HOME=/home/<user>/.hermes
HUB_DIR=/opt/hermes-hub
PORT=8791
# Hermes API server the hub validates keys against
HERMES_API=http://127.0.0.1:8889

# Push relay (URL and key are given by the owner of the Companion app)
HERMES_RELAY_URL=
HERMES_RELAY_KEY=

# Optional local ntfy (leave alone if unused)
NTFY_URL=http://127.0.0.1:8091
NTFY_TOPIC=hermes-events
# NTFY_TOKEN_PATH=/opt/hermes-hub/ntfy.token

# Optional: ops allowlist file (see ops-allowlist.example.txt)
# OPS_ALLOWLIST=/opt/hermes-hub/ops-allowlist.txt

# Optional decisions forwarder (disabled unless URL and key are set)
# DECISIONS_URL=
# DECISIONS_API_KEY=
# DECISIONS_MODEL_PREFIX=
