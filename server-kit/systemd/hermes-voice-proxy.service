[Unit]
Description=Hermes voice: speech-to-text failover proxy (GPU box first, then a local engine)
After=network.target

[Service]
Type=simple
@SERVICE_USER_LINE@
EnvironmentFile=-@VOICE_DIR@/voice.env
ExecStart=@PYTHON@ @VOICE_DIR@/whisper-proxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=@WANTED_BY@
