[Unit]
Description=Hermes voice: speech-to-text (Wyoming, Parakeet TDT v3, live partials)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
@SERVICE_USER_LINE@
Environment=HF_HUB_DISABLE_XET=1
@LD_LIBRARY_LINE@
EnvironmentFile=-@VOICE_DIR@/voice.env
ExecStart=@VOICE_DIR@/venv-stt/bin/python @VOICE_DIR@/parakeet_server.py --uri tcp://0.0.0.0:@STT_PORT@
Restart=always
RestartSec=5

[Install]
WantedBy=@WANTED_BY@
