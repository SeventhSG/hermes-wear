[Unit]
Description=Hermes voice: text-to-speech (Wyoming, Kokoro English + Piper Bulgarian)
After=network-online.target

[Service]
Type=simple
@SERVICE_USER_LINE@
Nice=5
Environment=KOKORO_DIR=@VOICE_DIR@/kokoro
Environment=PIPER_DIR=@VOICE_DIR@/piper-voices
EnvironmentFile=-@VOICE_DIR@/voice.env
ExecStart=@VOICE_DIR@/venv-tts/bin/python @VOICE_DIR@/piper_server.py --uri tcp://0.0.0.0:@TTS_PORT@
Restart=always
RestartSec=5

[Install]
WantedBy=@WANTED_BY@
