[Unit]
Description=Claude Code bridge for Hermes Companion (Claude Agent SDK)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=@HOME@
Environment=PYTHONUNBUFFERED=1
# CLAUDE_BRIDGE_TOKEN and CLAUDE_BRIDGE_CWD (optional CLAUDE_BRIDGE_HOST/PORT, default 127.0.0.1:8792).
EnvironmentFile=@CLAUDE_BRIDGE_DIR@/env
WorkingDirectory=@CLAUDE_BRIDGE_DIR@
ExecStart=@CLAUDE_BRIDGE_DIR@/venv/bin/python -m bridge.claude_bridge
Restart=on-failure
RestartSec=5

[Install]
WantedBy=@WANTED_BY@
