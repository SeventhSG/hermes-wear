[Unit]
Description=Hermes backend (hermes serve) on loopback for the Companion hub's slash commands
After=network.target hermes-gateway.service

[Service]
Type=simple
Environment=HOME=@HOME@
Environment=HERMES_HOME=@HERMES_HOME@
Environment=HERMES_DESKTOP=1
Environment=PATH=@PATH@
# HERMES_DASHBOARD_SESSION_TOKEN comes from the token file, which hermes-hub reads too.
ExecStart=/bin/bash -c 'HERMES_DASHBOARD_SESSION_TOKEN=$(cat @HERMES_HOME@/secrets/hermes-serve.token) exec @HERMES_BIN@ serve --host 127.0.0.1 --port 9119 --skip-build'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=@WANTED_BY@
