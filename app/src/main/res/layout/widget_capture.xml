<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews cannot be built in code, so this is the one place the app needs a layout file. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#0E0E11"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widgetGlyph"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_mic"
        android:contentDescription="Record a capture" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture"
            android:textColor="#F2F2F4"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to record · bolt to type"
            android:textColor="#8A8A93"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widgetType"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_bolt"
        android:background="#00000000"
        android:contentDescription="Type a capture" />
</LinearLayout>
