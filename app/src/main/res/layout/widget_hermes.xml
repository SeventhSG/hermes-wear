<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hwRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_lab_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="Hermes"
            android:textColor="#A3ACBA"
            android:textSize="13sp"
            android:fontFamily="@font/spacegrotesk_medium"
            android:singleLine="true" />

        <TextView
            android:id="@+id/hwNeeds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#F2B544"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hwDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="●"
            android:contentDescription="Homelab status unknown"
            android:textColor="#A3ACBA"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hwTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textColor="#E8ECF2"
        android:textSize="16sp"
        android:fontFamily="@font/spacegrotesk_medium"
        android:singleLine="true" />

    <TextView
        android:id="@+id/hwPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:textColor="#A3ACBA"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hwAsk"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="Ask"
            android:textColor="#E8ECF2"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/hwMic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_mic"
            android:contentDescription="Voice" />

        <TextView
            android:id="@+id/hwChat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="Chat"
            android:textColor="#E8ECF2"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
