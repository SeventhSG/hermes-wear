<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/labRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_lab_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/labDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:contentDescription="Homelab status unknown"
                android:textColor="#A3ACBA"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/labNode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="Homelab"
                android:textColor="#A3ACBA"
                android:textSize="13sp"
                android:fontFamily="@font/spacegrotesk_medium"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/labMetric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrainsmono_medium"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:paddingTop="4dp"
            android:text="--"
            android:textColor="#E8ECF2"
            android:textSize="32sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/labStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrainsmono_regular"
            android:fontFeatureSettings="tnum"
            android:textColor="#A3ACBA"
            android:textSize="12sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/labGuests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A3ACBA"
            android:textSize="12sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/labProblem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A3ACBA"
            android:textSize="12sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/labUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A3ACBA"
            android:textSize="12sp"
            android:singleLine="true" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/labRefresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_refresh"
        android:background="#00000000"
        android:contentDescription="Refresh" />
</LinearLayout>
